NODE_ENV="production"
PORT="3000"
SITE_URL="http://localhost:3100"
APP_URL="http://localhost:3100"
# HTTP staging must not mark the auth cookie Secure; production HTTPS should set this to true.
AUTH_COOKIE_SECURE="false"
SITE_NAME="燕中校友数字母港 - Staging"
SESSION_SECRET="replace-with-at-least-32-random-characters"
ROOT_ADMIN_EMAIL="acceptance-admin@example.test"
MP_DEV_MOCK_LOGIN_ENABLED="false"
MP_DEV_MOCK_USER_IDS=""
WECHAT_MINIPROGRAM_APP_ID=""
WECHAT_MINIPROGRAM_APP_SECRET=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="燕中数字母港 <noreply@example.test>"
# Generate one value with `openssl rand -hex 32` and use it in both entries.
STAGING_REDIS_PASSWORD="replace-with-at-least-32-random-characters"
REDIS_URL="redis://:replace-with-at-least-32-random-characters@redis:6379/1"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
STAGING_PORT="3100"
